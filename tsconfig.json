{
  "compilerOptions": {
    "target": "es2020",
    "module": "commonjs",
    "strict": true,
    "moduleResolution": "node",
    "esModuleInterop": true,
    "outDir": "./dist",
    "rootDir": "./",
    "skipLibCheck": true,
    "noEmit": false
  },
  "include": [
    "extensions/**/*.ts",
    "extensions/**/*.d.ts",
    "src/**/*.ts",
    "src/**/*.d.ts"
  ]
}